# Canonical production URL (defaults to https://aidenguan.com in production)
NEXT_PUBLIC_SITE_URL=https://aidenguan.com

# Required for the private /admin editor.
ADMIN_PASSWORD=choose-a-long-random-password

# Added automatically when the Vercel Blob store is connected (legacy/fallback).
BLOB_READ_WRITE_TOKEN=

# Cloudflare R2 Storage (10GB free, $0 egress, unlimited bandwidth)
R2_ACCOUNT_ID=fa8aec903e00a2ce99360fe6c23853cd
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=portfolio-media
R2_PUBLIC_URL=

# Hard Blocker Safety Limits (Protects from ever incurring Cloudflare charges)
# R2_MAX_STORAGE_GB: Hard ceiling in GB before all uploads are blocked (default: 5, max: 9.5; free tier is 10 GB)
R2_MAX_STORAGE_GB=5
# R2_MAX_FILES: Maximum objects allowed in the bucket before blocking uploads (default: 1000)
R2_MAX_FILES=1000
