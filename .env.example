# Canonical production URL (defaults to https://aidenguan.com in production)
NEXT_PUBLIC_SITE_URL=https://aidenguan.com

# Required for the private /admin editor.
ADMIN_PASSWORD=choose-a-long-random-password

# Added automatically when the Vercel Blob store is connected (legacy/fallback).
BLOB_READ_WRITE_TOKEN=

# Cloudflare R2 Storage (Recommended: 10GB free, $0 egress, unlimited bandwidth)
R2_ACCOUNT_ID=fa8aec903e00a2ce99360fe6c23853cd
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=portfolio-media
R2_PUBLIC_URL=
